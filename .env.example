# Copy to .env.local (which git ignores) and fill in.

# Optional. Google Books fills in page counts, genres and book heights that
# Open Library is missing. Without a key, requests share a tiny public quota
# and usually fail, and the app falls back to Open Library alone.
# Get a key at https://console.cloud.google.com/apis/credentials (enable "Books API").
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
