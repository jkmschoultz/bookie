{
  "name": "bookie",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "jpeg-js": "^0.4.4",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/jest": "30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3",
    "wrangler": "4.161.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "export:cloudflare": "expo export --platform web && node scripts/prepare-cloudflare.mjs",
    "deploy:prod": "npm run export:cloudflare && node scripts/pages-deploy.mjs master",
    "deploy:staging": "npm run export:cloudflare && node scripts/pages-deploy.mjs staging",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "api:dev": "npm run export:cloudflare && wrangler d1 migrations apply bookie-staging --local && wrangler pages dev dist"
  },
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/server/",
          "<rootDir>/shared/"
        ]
      },
      {
        "displayName": "api",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/server",
          "<rootDir>/shared"
        ],
        "testMatch": [
          "**/__tests__/**/*.test.ts"
        ],
        "transform": {
          "\\.ts$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      }
    ]
  }
}
